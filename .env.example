# Copiez ce fichier en .env et remplissez vos valeurs.
# Ne commitez JAMAIS le fichier .env (il est dans .gitignore).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.adresse@gmail.com
# Pour Gmail : utilisez un "mot de passe d'application", pas votre mot de passe principal
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM=votre.adresse@gmail.com
# Plusieurs destinataires séparés par des virgules
MAIL_TO=destinataire@exemple.fr
